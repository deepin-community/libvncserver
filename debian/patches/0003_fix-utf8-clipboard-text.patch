+/*
+ * rfbDefaultSetXCutTextUTF8() - Default handler for UTF-8 cut text.
+ *
+ * When the system locale uses UTF-8 encoding, this default callback is
+ * installed so that the Extended Clipboard extension can be negotiated
+ * and the basic ClientCutText UTF-8 detection path can route valid UTF-8
+ * text through this handler.  It simply delegates to setXCutText, because
+ * on a UTF-8 system the application's Latin-1 handler (or the no-op
+ * default) already receives the raw bytes correctly.
+ */
+static void rfbDefaultSetXCutTextUTF8(char* text, int len, rfbClientPtr cl)
+{
+    if (cl && cl->screen && cl->screen->setXCutText)
+        cl->screen->setXCutText(text, len, cl);
+}
