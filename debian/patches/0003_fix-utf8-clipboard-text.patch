+   /* If the system locale uses UTF-8, provide a default UTF-8 cut-text
+    * handler so that Extended Clipboard negotiation and basic-path UTF-8
+    * detection are effective without requiring the application to set
+    * the callback explicitly. */
+   {
+       rfbBool systemIsUTF8 = FALSE;
+#if defined(LIBVNCSERVER_HAVE_LANGINFO_H) && defined(LIBVNCSERVER_HAVE_LOCALE_H)
+       char *orig_locale = setlocale(LC_CTYPE, NULL);
+       char *saved_locale = orig_locale ? strdup(orig_locale) : NULL;
+       if (saved_locale != NULL) {
+           setlocale(LC_CTYPE, "");
+           const char *codeset = nl_langinfo(CODESET);
+           if (codeset != NULL &&
+               (strcasecmp(codeset, "UTF-8") == 0 ||
+                strcasecmp(codeset, "UTF8") == 0))
+               systemIsUTF8 = TRUE;
+           /* Restore original locale */
+           setlocale(LC_CTYPE, saved_locale);
+           free(saved_locale);
+       }
+#endif
+       screen->setXCutTextUTF8 = systemIsUTF8 ? rfbDefaultSetXCutTextUTF8 : NULL;
+   }
 #endif
    screen->getCursorPtr = rfbDefaultGetCursorPtr;
    screen->setTranslateFunction = rfbSetTranslateFunction;
diff --git a/src/libvncserver/rfbserver.c b/src/libvncserver/rfbserver.c
index 8e3c3f6..c936b05 100644
--- a/src/libvncserver/rfbserver.c
+++ b/src/libvncserver/rfbserver.c
@@ -100,6 +100,79 @@
 #endif
 #endif
 
+
+/*
+ * rfbIsValidUTF8() - Check whether the given byte sequence is valid UTF-8.
+ *
+ * Returns TRUE if the data is valid UTF-8, FALSE otherwise.
+ * ASCII (0x00-0x7F) is always valid UTF-8, so pure-ASCII text passes.
+ * Most Latin-1 text with bytes > 0x7F is NOT valid UTF-8 due to strict
+ * multi-byte sequence rules, so it correctly fails and falls back to
+ * the Latin-1 handler.
+ */
+static rfbBool
+rfbIsValidUTF8(const char *str, int len)
+{
+    int i = 0;
+    const unsigned char *s = (const unsigned char *)str;
+
+    if (str == NULL || len <= 0)
+        return TRUE;
+
+    while (i < len) {
+        unsigned char c = s[i];
+        int seq_len, j;
+
+        if (c <= 0x7F) {
+            /* ASCII byte */
+            i++;
+            continue;
+        }
+
+        /* Determine expected sequence length from leading byte */
+        if ((c & 0xE0) == 0xC0)
+            seq_len = 2;
+        else if ((c & 0xF0) == 0xE0)
+            seq_len = 3;
+        else if ((c & 0xF8) == 0xF0)
+            seq_len = 4;
+        else
+            return FALSE; /* Invalid leading byte */
+
+        /* Check that we have enough continuation bytes */
+        if (i + seq_len > len)
+            return FALSE;
+
+        /* Validate continuation bytes (must be 10xxxxxx) */
+        for (j = 1; j < seq_len; j++) {
+            if ((s[i + j] & 0xC0) != 0x80)
+                return FALSE;
+        }
+
+        /* Check for overlong encodings and invalid code points */
+        if (seq_len == 2) {
+            if (c < 0xC2)
+                return FALSE; /* Overlong */
+        } else if (seq_len == 3) {
+            unsigned char c2 = s[i + 1];
+            if (c == 0xE0 && c2 < 0xA0)
+                return FALSE; /* Overlong */
+            if (c == 0xED && c2 > 0x9F)
+                return FALSE; /* Surrogate (U+D800..U+DFFF) */
+        } else if (seq_len == 4) {
+            unsigned char c2 = s[i + 1];
+            if (c == 0xF0 && c2 < 0x90)
+                return FALSE; /* Overlong */
+            if (c > 0xF4)
+                return FALSE; /* Above U+10FFFF */
+        }
+
+        i += seq_len;
+    }
+
+    return TRUE;
+}
+
 #ifdef LIBVNCSERVER_HAVE_LIBJPEG
 /*
